# Порт HTTP-сервера бэкенда (в проде единственный публичный порт).
PORT=8080

# S3-совместимое хранилище (rustfs / MinIO). forcePathStyle, ключи относительно бакета.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=photos

# Логин администратора. Пароль обязателен: без него сервер не стартует.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Секрет для подписи сессионной cookie. Пусто -> детерминированный запасной ключ от логина и пароля.
SESSION_SECRET=

# Лимит размера одного загружаемого файла, МБ.
MAX_UPLOAD_MB=512

# Параметры превью: сторона (px) и качество (1..100).
THUMB_SIZE=512
THUMB_QUALITY=80

# Secure у cookie сессии. Включать только за HTTPS.
COOKIE_SECURE=false
