# Единый .env для docker compose. Скопируйте: cp .env.example .env
# Правки VITE_* попадают в образ только при пересборке: docker compose up -d --build

# ---- Порты хоста ----
HOST_PORT=8080
S3_PORT=9000
S3_CONSOLE_PORT=9001

# ---- S3: бакет и ключи ----
# Один pair ключей и для MinIO, и для бэкенда.
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=photos
S3_REGION=us-east-1
# Внутренний адрес S3 — как его видят контейнеры бэкенда и s3-init.
# Для внешнего rustfs/minio замените на его URL в контейнерной сети или во внешнем окружении.
S3_ENDPOINT=http://minio:9000

# ---- Публичный сайт (бэкится в сборку front) ----
# URL S3 ИЗ браузера пользователя: хост + S3_PORT. Поменяли S3_PORT — поменяйте и сюда.
VITE_S3_ENDPOINT=http://localhost:9000
# Должно совпадать с S3_BUCKET.
VITE_S3_BUCKET=photos
VITE_SITE_TITLE=Фото

# ---- Админка ----
ADMIN_LOGIN=admin
# Обязательно: без пароля бэкенд не стартует.
ADMIN_PASSWORD=

# ---- Опционально ----
# Пусто — секрет выводится из логина и пароля.
SESSION_SECRET=
MAX_UPLOAD_MB=512
THUMB_SIZE=512
THUMB_QUALITY=70
# true только за HTTPS.
COOKIE_SECURE=false
